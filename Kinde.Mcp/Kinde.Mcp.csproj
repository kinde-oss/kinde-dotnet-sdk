<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Kinde.SDK.Mcp</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Kinde</Authors>
    <Company>Kinde</Company>
    <Product>Kinde Platform</Product>
    <Description>Kinde authentication for MCP servers built with the C# ModelContextProtocol SDK. Wires a Kinde AI agents and MCP application into the MCP SDK's authentication scheme and protected resource metadata.</Description>
    <Copyright>Kinde</Copyright>
    <Version>2.6.0</Version>
    <RepositoryUrl>https://github.com/kinde-oss/kinde-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Kinde;Authentication;MCP;Agents;ModelContextProtocol</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>1591</NoWarn>
    <PackageProjectUrl>https://github.com/kinde-oss/kinde-dotnet-sdk</PackageProjectUrl>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kinde.Api.Agents\Kinde.Api.Agents.csproj" />
  </ItemGroup>

</Project>
