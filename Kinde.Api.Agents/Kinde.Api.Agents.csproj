<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Kinde.SDK.Agents</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Kinde</Authors>
    <Company>Kinde</Company>
    <Product>Kinde Platform</Product>
    <Description>ASP.NET Core integration for the Kinde .NET SDK: accept access tokens issued by a Kinde AI agents and MCP application, and serve the protected resource metadata an MCP client needs to discover Kinde.</Description>
    <Copyright>Kinde</Copyright>
    <Version>2.6.0</Version>
    <RepositoryUrl>https://github.com/kinde-oss/kinde-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Kinde;Authentication;MCP;Agents;AspNetCore</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>1591</NoWarn>
    <PackageProjectUrl>https://github.com/kinde-oss/kinde-dotnet-sdk</PackageProjectUrl>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- Separate package: this FrameworkReference propagates into every consumer, so folding it
       into Kinde.SDK would force the ASP.NET runtime on console and worker apps. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kinde.Api\Kinde.Api.csproj" />
  </ItemGroup>

</Project>
